PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bm_task_manager
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Security Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
